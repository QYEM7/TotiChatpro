# Public client configuration is generated by the approved build's backend config.
# Never ship secrets or service_role keys in the web/Android bundle.
SUPABASE_PROJECT_ID=sqedsnyvjblvbjbizcay
SUPABASE_URL=https://sqedsnyvjblvbjbizcay.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Configure these ONLY as Supabase Edge Function secrets.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# OAuth and SMTP are configured in Supabase Auth settings, not client variables.
# Google: client ID/secret, consent screen, allowed callback URLs.
# Apple: service ID, team ID, key ID, private key, authorized domain.
# Facebook: app ID/secret, live app, allowed callback URLs.
# SMTP: host, port, verified sender, username/password, TLS.
# Redirect allowlist must include the real web app and com.totichat.beta://auth/callback.
# LiveKit deployment must provide working TURN/STUN for restrictive networks.
# Recharge uses the Owner -> agent -> user model; no invented payment checkout.

# Local/server-only values; never expose or include them in the client build.
SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_SERVICE_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_FILE=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Real acceptance accounts: confirmed, authorized, with actual funded balance.
TEST_USER1_EMAIL=
TEST_USER1_PASSWORD=
TEST_USER1_TOTP_SECRET=
TEST_USER2_EMAIL=
TEST_USER2_PASSWORD=
TEST_USER2_TOTP_SECRET=
TEST_ROOM_ID=
E2E_BASE_URL=
# Release signing is independent of the debug APK workflow.
