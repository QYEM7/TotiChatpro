<diagram id="totichat-09" name="09 Release gates and scope"><mxGraphModel dx="2800" dy="1650" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2800" pageHeight="1650" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="RELEASE READINESS | NO GO UNTIL VERIFIED" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fillColor=#15283F;strokeColor=#15283F;fontColor=#FFFFFF;fontSize=32;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=10;fontStyle=1;strokeWidth=1.8;shadow=0;" vertex="1" parent="1"><mxGeometry x="35" y="18" width="2730" height="88" as="geometry"/></mxCell><mxCell id="3" value="Verification is evidence-based. Existence of source files is not acceptance. No APK/AAB requested or produced." style="text;html=0;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=17;fontColor=#3E536D;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="55" y="115" width="2690" height="54" as="geometry"/></mxCell><mxCell id="4" value="GREEN = present in Flutter source / Staging schema" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fillColor=#E5F7F1;strokeColor=#118265;fontColor=#114A3B;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=10;fontStyle=0;strokeWidth=1.8;shadow=0;" vertex="1" parent="1"><mxGeometry x="55" y="1576" width="480" height="42" as="geometry"/></mxCell><mxCell id="5" value="AMBER = incomplete or needs real-device QA" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fillColor=#FFF2D9;strokeColor=#D39A31;fontColor=#725018;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=10;fontStyle=0;strokeWidth=1.8;shadow=0;" vertex="1" parent="1"><mxGeometry x="545" y="1576" width="490" height="42" as="geometry"/></mxCell><mxCell id="6" value="GRAY = deferred / not implemented" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fillColor=#EFF2F5;strokeCo